OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_CHAT_MODEL=gpt-5-mini
METEORA_API_BASE_URL=https://dlmm.datapi.meteora.ag
