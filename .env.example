# Required for document and query embeddings.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_CHAT_MODEL=gpt-5-mini
METEORA_API_BASE_URL=https://dlmm.datapi.meteora.ag
APP_DB_PATH=data/application.db

# Defaults for commands executed inside Docker Compose.
ELASTICSEARCH_URL=http://elasticsearch:9200
PREFECT_API_URL=http://prefect:4200/api

# Optional comma-separated override; blank discovers DLMM pages from llms.txt.
METEORA_DOC_URLS=
